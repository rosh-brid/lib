<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/bg_log"
     android:gravity="center"
     android:id="@+id/inti">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:background="@drawable/bg_kotak"
         android:padding="5dp"
         android:layout_margin="15dp"
         android:orientation="vertical"
         android:backgroundTint="@color/bg_pop"
         android:id="@+id/anak">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:padding="10dp"
             android:layout_margin="5dp"
             android:textSize="18sp"
             android:fontFamily="@font/alkdots"
             android:text="Extract Unpac"
             android:textStyle="bold" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:text="File"
             android:id="@+id/nama_file" />

        <ProgressBar
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_margin="10dp"
             android:id="@+id/proses"
             android:layout_gravity="center_horizontal" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:layout_marginBottom="20dp"
             android:id="@+id/nama_proses"
             android:layout_gravity="center_horizontal" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="end"
             android:layout_margin="15dp">

            <TextView
                 android:layout_height="40dp"
                 android:layout_width="80dp"
                 android:gravity="center"
                 android:textSize="16sp"
                 android:text="Cencel"
                 android:textStyle="bold"
                 android:id="@+id/n" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>